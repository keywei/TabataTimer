{
  "permissions": {
    "allow": [
      "Bash(flutter --version)",
      "Bash(flutter create *)",
      "Bash(flutter pub *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-/Users/keywei/Developer/TabataTiimer/TabataTimer}/scripts/refresh-ios-profile-hook.sh\"",
            "statusMessage": "Refreshing iOS provisioning profile"
          }
        ]
      }
    ]
  }
}
